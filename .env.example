# Google Cloud: OAuth client type = Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Kakao Developers: REST API key and its enabled client secret.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# Keep false on production until public groups and launch checks are ready.
# true enables nickname onboarding without a service invitation.
KOKKO_PUBLIC_SIGNUP=false
# Generate once: openssl rand -hex 16
# Keep this 32-character key outside Git and back it up separately.
PB_ENCRYPTION_KEY=
